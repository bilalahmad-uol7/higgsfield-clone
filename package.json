{
  "name": "higgsfield-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:push": "bash -c 'set -a && . ./.env.local && set +a && supabase db push --db-url \"$SUPABASE_DB_URL\"'",
    "db:types": "bash -c 'set -a && . ./.env.local && set +a && supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema public > src/lib/supabase/database.types.ts'",
    "stripe:seed": "tsx --env-file=.env.local scripts/stripe-seed.mts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "make-admin": "tsx --env-file=.env.local scripts/make-admin.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
