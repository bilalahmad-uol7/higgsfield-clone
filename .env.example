# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Public base URL of the app (used for OAuth + Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Media source: "cdn" (default, hotlinks higgsfield.ai) or "local" (/public/demo)
# NEXT_PUBLIC_MEDIA_SOURCE=local

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret (service-role) key — server only. Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_...
# Supabase → Project Settings → Database → Connection string (session pooler URI).
# Used only by `npm run db:push` / `npm run db:types`.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Stripe (TEST mode) → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Image generation — Pollinations.ai. Works with NO key (free keyless tier:
# rate-limited per IP, service-chosen model, < ~1MP). Optionally add an `sk_`
# key from https://enter.pollinations.ai/keys to use gen.pollinations.ai with
# a model of your choice. Server only.
# POLLINATIONS_API_KEY=sk_...
# POLLINATIONS_MODEL=flux
# Force the demo-sample failsafe instead of calling Pollinations (demos/tests).
# POLLINATIONS_DISABLED=1
